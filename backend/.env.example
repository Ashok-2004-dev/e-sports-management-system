# Copy this file to .env locally. Never commit .env.
PORT=5000
DB_HOST=YOUR_MYSQL_HOST
DB_PORT=YOUR_MYSQL_PORT
DB_USER=avnadmin
DB_PASSWORD=YOUR_AIVEN_PASSWORD
DB_NAME=emsdb
DB_SSL=true
DB_SSL_CA=certs/ca.pem

# Use private values. Keep these out of GitHub.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=CHOOSE_A_PRIVATE_ADMIN_PASSWORD
ADMIN_EMAIL=admin@esports.bt
ADMIN_SETUP_KEY=REPLACE_WITH_A_PRIVATE_SETUP_KEY
CLIENT_URL=http://localhost:5173

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Social login (needed for the Google and Facebook buttons)
# GOOGLE_CLIENT_ID and FACEBOOK_APP_ID must be the same values as in frontend/.env
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
# Facebook App Secret: backend only, never put it in the frontend or on GitHub
FACEBOOK_APP_SECRET=
